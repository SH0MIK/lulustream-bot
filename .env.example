BOT_TOKEN=
LULUSTREAM_API_KEY=

# Strongly recommended for a personal bot.
# Comma-separated Telegram numeric user IDs.
ALLOWED_USER_IDS=

# Required by the local Telegram Bot API server.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Internal Docker URL. Leave this unchanged unless you know why you need to change it.
TELEGRAM_API_ROOT=http://telegram-bot-api:8081
